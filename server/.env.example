PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profportfolio?schema=public"
JWT_SECRET="replace_me_with_a_long_random_secret"
JWT_EXPIRES_IN="7d"
CLIENT_ORIGIN="https://app.example.com,https://www.app.example.com"

# Google Cloud Translate (Service Account JSON)
# 1) Create a Service Account with Cloud Translation API access
# 2) Download JSON key file and set the path below
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS="C:\\path\\to\\service-account.json"

